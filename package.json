{
  "name": "susidnia-kukhnia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @food-delivery/web",
    "generate": "npm run generate -w @food-delivery/backend",
    "build": "npm run generate && npm run build --workspaces",
    "build:pages": "node scripts/prepare-pages.mjs && npm run build -w @food-delivery/web -- --mode pages",
    "preview:pages": "npm run preview -w @food-delivery/web -- --mode pages --port 4173 --strictPort",
    "check": "npm run generate && node scripts/check.mjs && npm run check --workspaces",
    "test": "npm run generate && npm run build -w @food-delivery/backend && node scripts/prepare-pages.mjs && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node scripts/prepare-pages.mjs && node --test --test-concurrency=1 tests/browser-runtime.test.mjs tests/browser-auth.test.mjs",
    "db:deploy": "node scripts/deploy.mjs",
    "db:studio": "node scripts/prisma.mjs studio",
    "db:catalog": "node scripts/catalog.mjs",
    "db:demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
